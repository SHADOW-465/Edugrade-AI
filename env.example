# API Keys
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Database
DATABASE_URL=sqlite:///./edugrade.db
# For production: postgresql://user:password@localhost/edugrade

# File Storage
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
GRADES_DIR=./grades

# Model Settings
YOLO_MODEL_PATH=./models/yolo_answer_sheet.pt
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten
MAX_IMAGE_SIZE=4096
CONFIDENCE_THRESHOLD=0.5

# Grading Settings
DEFAULT_RUBRIC_PATH=./config/default_rubric.json
PARTIAL_MARKING_ENABLED=true
FEEDBACK_LENGTH=medium

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here
HASH_SALT=your_hash_salt_here
